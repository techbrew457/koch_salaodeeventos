            emoji = "✅" if st_ev == "Confirmado" else ("❌" if st_ev == "Cancelado" else "⏳")
            dt_fmt = formatar_data_br(ev.get("date"))
            
            total_venda, sinal_cad, restante = calcular_totais(ev)
            v_desc = float(ev.get("valor_desconto", 0) or 0)

            with st.container(border=True):
                col_i1, col_i2 = st.columns([3, 1])
                with col_i1:
                    st.markdown(f"**{emoji} Data: {dt_fmt} - {ev.get('cliente')}**")
                    st.caption(f"Turno: **{ev.get('turno')}** | Evento: {ev.get('tipo_evento')} | Pessoas: {ev.get('qtd_pessoas')} | Status: **{st_ev}**")
                    
                    tel = "".join(filter(str.isdigit, ev.get("telefone", "")))
                    if tel: st.markdown(f"[💬 Abrir WhatsApp](https://wa.me/55{tel})")
                    
                    st.markdown(f"💰 **Total (c/ Desconto):** R$ {total_venda:,.2f} | 💵 **Sinal:** R$ {sinal_cad:,.2f} | 🔴 **Falta Pagar:** **R$ {restante:,.2f}**")
                    if v_desc > 0:
                        st.caption(f"🏷️ Desconto aplicado: R$ {v_desc:,.2f}")
                    
                    barris_Str = ", ".join([f"{b['litros']}L {b['estilo']}" for b in ev.get("barris", [])]) or "Nenhum chopp"
                    st.text(f"Barris: {barris_Str}")

                with col_i2:
                    btn_edit = st.button("✏️ Editar", key=f"ed_{ev_id}", use_container_width=True)
                    btn_docx = st.button("📄 Contrato", key=f"ct_{ev_id}", use_container_width=True)
                    btn_del = st.button("🗑️ Excluir", key=f"dl_{ev_id}", use_container_width=True)

                if btn_del:
                    reservas = [r for r in reservas if r.get("id") != ev_id]
                    if salvar_dados_nuvem(reservas):
                        st.success("Excluído com sucesso!")
                        st.rerun()

                if btn_docx:
                    txt_barris = "\n".join([f"- {b['litros']}L de Chopp {b['estilo']} - R$ {b['valor_total']:,.2f}" for b in ev.get("barris", [])]) or "Nenhum."
                    if ev.get("chopp_cons_sn") == "Sim":
                        txt_barris += f"\n- Consignado Extra: {ev.get('chopp_cons_litros')}L de {ev.get('chopp_cons_estilo')}"
                    
                    op_list = []
                    if ev.get("som_sn") == "Sim": op_list.append(f"- Som: R$ {ev.get('valor_som'):,.2f}")
                    if ev.get("retro_sn") == "Sim": op_list.append(f"- Retroprojetor: R$ {ev.get('valor_retroprojetor'):,.2f}")
                    if ev.get("cuidador_sn") == "Sim": op_list.append("- Monitor/Cuidador: Incluso")
                    if float(ev.get("valor_taxa_adicional", 0)) > 0: op_list.append(f"- Taxa: R$ {ev.get('valor_taxa_adicional'):,.2f}")
                    if v_desc > 0: op_list.append(f"- Desconto Concedido: R$ {v_desc:,.2f}")
                    txt_opc = "\n".join(op_list) if op_list else "Nenhum opcional."

                    arq = gerar_documento_word(ev, dt_fmt, ev.get("barris", []), txt_opc, txt_barris)
                    if arq:
                        st.download_button("📥 Baixar Contrato Word", arq, file_name=f"Contrato_{ev.get('cliente','').replace(' ','_')}.docx", mime="application/vnd.openxmlformats-officedocument.wordprocessingml.document", key=f"dl_doc_{ev_id}")
                    else:
                        st.warning("⚠️ Arquivo `modelo_contrato.docx` não encontrado no repositório.")

                if btn_edit:
                    st.session_state[f"edit_mode_{ev_id}"] = not st.session_state.get(f"edit_mode_{ev_id}", False)

                if st.session_state.get(f"edit_mode_{ev_id}", False):
                    st.divider()
                    with st.form(f"form_edit_{ev_id}"):
                        novos_dados = render_formulario(ev)
                        if st.form_submit_button("💾 Salvar Alterações"):
                            if not novos_dados["cliente"].strip():
                                st.warning("⚠️ O nome do cliente é obrigatório.")
                            else:
                                novos_dados["id"] = ev_id
                                reservas = [novos_dados if r.get("id") == ev_id else r for r in reservas]
                                if salvar_dados_nuvem(reservas):
                                    st.session_state[f"edit_mode_{ev_id}"] = False
                                    st.success("✅ Atualizado com sucesso!")
                                    st.rerun()
    else:
        st.info("Nenhuma locação cadastrada.")
